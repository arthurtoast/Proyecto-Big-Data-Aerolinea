# Copia este archivo a .env y pon tus credenciales reales (.env esta en .gitignore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vuelos
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Opcional: carga de FACT_VUELOS a MySQL
# auto = mide velocidad y usa muestra si la carga completa pasa de MYSQL_FACT_MAX_MIN minutos
# MYSQL_FACT_MODE=auto
# MYSQL_FACT_MAX_MIN=20
# MYSQL_FACT_SAMPLE_PCT=10
